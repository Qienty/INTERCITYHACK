# 可选：兼容 Chat Completions 的 AI 服务。不配置时，规则配单和导出照常运行。
# 请复制为 .env 后填写；密钥仅供本机服务端使用，绝不要提交到 Git。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
PORT=3000

# HTTPS 反向代理：推荐填浏览器实际访问的完整源（协议 + 域名 + 可选端口，无路径）
# 示例仅为配置说明，替换成实际部署地址；为空时按本机请求源校验。
PUBLIC_ORIGIN=
# 仅在本机反代正确覆盖 X-Forwarded-Proto 时启用；不信任远程地址传入的该头。
TRUST_PROXY=false
